---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getWriting } from '../../lib/content';
const articles = await getWriting();
const tags = [...new Set(articles.flatMap((a) => a.data.tags))].sort();
---

<Base
  title="Writing"
  description="Technical articles and notes on ML systems, computer systems, and engineering."
>
  <header class="page-heading">
    <p class="eyebrow">NOTES FROM THE WORKBENCH</p>
    <h1>
      Learn, build, write<span class="accent">.</span>
    </h1>
    <p>
      Turning observations into understanding.
      <br />
      Notes on systems, models, and questions worth revisiting.
    </p>
  </header>
  {articles.length > 0 ? (
    <>
      <div class="filter-bar" aria-label="Filter articles by tag">
        <button data-tag="" aria-pressed="true">
          All <span>{articles.length}</span>
        </button>
        {tags.map((tag) => (
          <button data-tag={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>
      <p id="filter-status" class="sr-only" aria-live="polite"></p>
      <ArticleList articles={articles} />
      <p id="no-results" hidden>
        No articles with this tag yet.{' '}
        <a href={url('/writing/')}>View all articles</a>
      </p>
    </>
  ) : (
    <div class="writing-page-empty">
      <span class="mono">01 — A FRESH PAGE</span>
      <h2>An open notebook.</h2>
      <p>
        The first posts are in progress. In the meantime,
        <br />
        take a look at some of my engineering projects.
      </p>
      <a class="text-link" href={url('/projects/')}>
        Explore projects ↗
      </a>
    </div>
  )}
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
  const rows = document.querySelectorAll<HTMLElement>(
    '.article-row[data-tags]',
  );
  function filter(tag: string) {
    let count = 0;
    rows.forEach((row) => {
      const match = !tag || JSON.parse(row.dataset.tags || '[]').includes(tag);
      row.hidden = !match;
      if (match) count++;
    });
    buttons.forEach((button) =>
      button.setAttribute('aria-pressed', String(button.dataset.tag === tag)),
    );
    const status = document.querySelector('#filter-status');
    if (status) status.textContent = `Showing ${count} articles`;
    const empty = document.querySelector<HTMLElement>('#no-results');
    if (empty) empty.hidden = count > 0;
  }
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const tag = button.dataset.tag || '';
      const url = new URL(location.href);
      tag ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
      history.pushState({}, '', url);
      filter(tag);
    }),
  );
  window.addEventListener('popstate', () =>
    filter(new URL(location.href).searchParams.get('tag') || ''),
  );
  filter(new URL(location.href).searchParams.get('tag') || '');
</script>
