---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import { experience, education } from '../data/experience';
---

<Base
  title="Experience"
  description="Work, research, education, and Formula Racing experience."
>
  <header class="page-heading">
    <p class="eyebrow">THE PATH SO FAR</p>
    <h1>
      Experience<span class="accent">.</span>
    </h1>
    <p>Learning through research and hands-on engineering.</p>
    <a class="text-link" href={url('/resume.pdf')}>
      Download resume ↗
    </a>
  </header>
  {['Work', 'Research', 'Activities'].map((type) => (
    <section class="experience-section">
      <h2>{type}</h2>
      {experience
        .filter((item) => item.type === type)
        .map((item) => (
          <article class="experience-row">
            <div class="experience-date mono">{item.period}</div>
            <div>
              <h3>{item.role}</h3>
              <p class="organization">{item.organization}</p>
              <p class="location mono">{item.location}</p>
              <p>{item.description}</p>
              {item.project && (
                <a class="text-link" href={url(`/projects/${item.project}/`)}>
                  Related projects ↗
                </a>
              )}
            </div>
          </article>
        ))}
    </section>
  ))}
  <section class="experience-section">
    <h2>Education</h2>
    {education.map((item) => (
      <article class="experience-row">
        <div class="experience-date mono">{item.date}</div>
        <div>
          <h3>{item.organization}</h3>
          <p class="organization">{item.degree}</p>
          <p class="location mono">{item.location}</p>
          <p>{item.courses}</p>
        </div>
      </article>
    ))}
  </section>
</Base>
