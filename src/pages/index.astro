---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectList from '../components/ProjectList.astro';
import ArticleList from '../components/ArticleList.astro';
import { getProjects, getWriting } from '../lib/content';
import { site } from '../data/site';
const projects = (await getProjects())
  .filter((p) => p.data.featured)
  .slice(0, 3);
const articles = (await getWriting()).slice(0, 3);
---

<Base>
  <section class="intro">
    <div class="intro-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> ENGINEER · BUILDER · LIFELONG LEARNER
      </p>
      <h1>
        Yen-Ta Lin<span class="accent">.</span>
      </h1>

      <p class="intro-description">{site.intro}</p>
      <SocialLinks />
    </div>
    <div
      class="system-note"
      aria-label="Research interests: models, runtimes, and hardware"
    >
      <span class="mono note-label">THINKING IN SYSTEMS</span>
      <div class="system-layer">
        <span class="mono">01</span> Model{' '}
        <span class="layer-note">Representation</span>
      </div>
      <div class="connector">↓</div>
      <div class="system-layer">
        <span class="mono">02</span> Runtime{' '}
        <span class="layer-note">Trade-offs</span>
      </div>
      <div class="connector">↓</div>
      <div class="system-layer">
        <span class="mono">03</span> Hardware{' '}
        <span class="layer-note">Constraints</span>
      </div>
      <p class="mono">ideas → implementation → insight</p>
    </div>
  </section>
  <section class="interests section">
    <div class="section-heading">
      <h2>
        <span class="mono section-number">01 /</span> Current interests
      </h2>
      <span class="eyebrow">ON MY MIND</span>
    </div>
    <div class="interest-grid">
      {site.interests.map((interest) => (
        <div>
          <h3>{interest.name}</h3>
          <p>{interest.text}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="section-heading">
      <h2>
        <span class="mono section-number">02 /</span> Selected projects
      </h2>
      <a class="text-link" href={url('/projects/')}>
        All projects <span aria-hidden="true">↗</span>
      </a>
    </div>
    <ProjectList projects={projects} />
  </section>
  <section class="section">
    <div class="section-heading">
      <h2>
        <span class="mono section-number">03 /</span> Recent writing
      </h2>
      <a class="text-link" href={url('/writing/')}>
        Writing index <span aria-hidden="true">↗</span>
      </a>
    </div>
    {articles.length ? (
      <ArticleList articles={articles} />
    ) : (
      <div class="writing-empty">
        <div>
          <span class="mono small-label">A NOTEBOOK, IN THE MAKING</span>
          <h3>Making room for ideas and observations.</h3>
          <p>
            Notes on building systems, reading papers, and solving problems.
            First posts coming soon.
          </p>
        </div>
        <span class="notebook-symbol" aria-hidden="true">
          [ … ]
        </span>
      </div>
    )}
  </section>
  <section class="section background-section">
    <div>
      <p class="eyebrow">A LITTLE BACKGROUND</p>
      <h2>
        Between software
        <br />
        and hardware.
      </h2>
    </div>
    <div>
      <p>{site.background}</p>
      <a class="text-link" href={url('/about/')}>
        More about me ↗
      </a>
    </div>
  </section>
  <section class="contact section">
    <span class="eyebrow">LET’S CONNECT</span>
    <h2>Have an interesting problem in mind?</h2>
    <p>Let’s talk embedded ML systems, engineering, or exchange notes.</p>
    <a class="contact-email" href={`mailto:${site.email}`}>
      {site.email} <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
