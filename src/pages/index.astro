---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectList from '../components/ProjectList.astro';
import ArticleList from '../components/ArticleList.astro';
import { getProjects, getWriting } from '../lib/content';
import { site } from '../data/site';
import { experience } from '../data/experience';
const projects = (await getProjects())
  .filter((p) => p.data.featured)
  .slice(0, 3);
const articles = (await getWriting()).slice(0, 3);
const homepageExperience = [
  experience.find(
    (item) => item.role === 'LLM Quantization for Edge Deployment',
  ),
  experience.find((item) => item.role === 'Research & Development Intern'),
  experience.find((item) => item.role === 'Electrical & Controls Team Lead'),
].filter((item) => item !== undefined);
---

<Base>
  <section class="intro">
    <div class="intro-copy">
      <p class="eyebrow">{site.identity}</p>
      <h1>
        Yen-Ta Lin<span class="accent">.</span>
      </h1>
      <p class="intro-description">{site.intro}</p>
      <SocialLinks />
    </div>
  </section>
  <section class="section">
    <div class="section-heading">
      <h2>
        <span class="mono section-number">01 /</span> Selected projects
      </h2>
      <a class="text-link" href={url('/projects/')}>
        All projects <span aria-hidden="true">↗</span>
      </a>
    </div>
    <ProjectList projects={projects} />
  </section>
  <section class="section">
    <div class="section-heading">
      <h2>
        <span class="mono section-number">02 /</span> Recent writing
      </h2>
      <a class="text-link" href={url('/writing/')}>
        Writing index <span aria-hidden="true">↗</span>
      </a>
    </div>
    {articles.length ? (
      <ArticleList articles={articles} />
    ) : (
      <div class="writing-empty">
        <div>
          <span class="mono small-label">A NOTEBOOK, IN THE MAKING</span>
          <h3>Making room for ideas and observations.</h3>
          <p>
            Notes on building systems, reading papers, and solving problems.
            First posts coming soon.
          </p>
        </div>
        <span class="notebook-symbol" aria-hidden="true">
          [ … ]
        </span>
      </div>
    )}
  </section>
  <section class="section">
    <div class="section-heading">
      <h2>
        <span class="mono section-number">03 /</span> Currently exploring
      </h2>
      <span class="eyebrow">WHAT I’M LEARNING NOW</span>
    </div>
    <div class="exploration-list">
      {site.exploring.map((item) => (
        <article>
          <span class="mono">{item.number}</span>
          <div>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section home-experience">
    <div class="section-heading">
      <h2>
        <span class="mono section-number">04 /</span> Experience
      </h2>
      <a class="text-link" href={url('/experience/')}>
        Full experience <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="home-experience-list">
      {homepageExperience.map((item) => (
        <article>
          <p class="mono">{item.period}</p>
          <div>
            <h3>{item.role}</h3>
            <p>{item.organization}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="contact section">
    <span class="eyebrow">LET’S CONNECT</span>
    <h2>Have an interesting problem in mind?</h2>
    <p>Let’s talk ML systems, efficient inference, or systems engineering.</p>
    <a class="contact-email" href={`mailto:${site.email}`}>
      {site.email} <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
